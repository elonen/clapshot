#!/bin/bash
#
# Clapshot Server default transcoding script
#
# Environment Variables (set by Clapshot Server):
#   CLAPSHOT_INPUT_FILE      - Path to sanitized input file (orig.ext format)
#   CLAPSHOT_OUTPUT_DIR      - Directory where output should be created
#   CLAPSHOT_OUTPUT_PREFIX   - Filename prefix (script decides extension)
#   CLAPSHOT_MEDIA_TYPE      - "video", "audio", or "image"
#   CLAPSHOT_TARGET_BITRATE  - Target bitrate in bits per second
#   CLAPSHOT_USER_ID         - User ID for logging
#   CLAPSHOT_MEDIA_ID        - Media file ID for logging
#   CLAPSHOT_DURATION        - Duration in seconds (decimal)
#   CLAPSHOT_PROGRESS_PIPE   - Named pipe for progress reporting (optional)
#
# Progress Reporting:
#   Write ffmpeg-style progress to $CLAPSHOT_PROGRESS_PIPE:
#     frame=584
#     fps=52.40
#     speed=2.1x
#     progress=continue
#   And finally:
#     progress=end
#

set -euo pipefail

# Validate required environment variables
: "${CLAPSHOT_INPUT_FILE:?Missing input file}"
: "${CLAPSHOT_OUTPUT_DIR:?Missing output directory}"
: "${CLAPSHOT_OUTPUT_PREFIX:?Missing output prefix}"
: "${CLAPSHOT_MEDIA_TYPE:?Missing media type}"
: "${CLAPSHOT_TARGET_BITRATE:?Missing target bitrate}"
: "${CLAPSHOT_USER_ID:?Missing user ID}"
: "${CLAPSHOT_MEDIA_ID:?Missing media ID}"
: "${CLAPSHOT_DURATION:?Missing duration}"

# Default configuration values (can be overridden)
VIDEO_CODEC="${VIDEO_CODEC:-libx264}"
VIDEO_PRESET="${VIDEO_PRESET:-faster}"
AUDIO_CODEC="${AUDIO_CODEC:-aac}"
# Fallback bitrate used only when a stream must be re-encoded (e.g. PCM → AAC).
# Streams already in a browser-compatible codec (aac, mp3, ac3, eac3, flac, opus, alac)
# are copied without re-encoding, so this value does not affect them.
AUDIO_BITRATE="${AUDIO_BITRATE:-192000}"
AUDIO_BITRATE_AUDIO="${AUDIO_BITRATE_AUDIO:-384k}"

# Hardware acceleration options (empty by default)
HWACCEL="${HWACCEL:-}"
HWACCEL_DEVICE="${HWACCEL_DEVICE:-}"
VIDEO_FILTER_SCALE="${VIDEO_FILTER_SCALE:-scale}"

# Source optional configuration file
if [ -f /etc/clapshot-transcode.conf ]; then
    source /etc/clapshot-transcode.conf
fi

# Set output file (always MP4 for compatibility)
OUTPUT_FILE="${CLAPSHOT_OUTPUT_DIR}/${CLAPSHOT_OUTPUT_PREFIX}.mp4"

# ---------------------------------------------------------------------------
# build_audio_map REENCODE_BITRATE
#
# Populates the global AUDIO_STREAM_OPTS array with per-stream codec options
# for every audio stream in CLAPSHOT_INPUT_FILE.
#
# Codecs that can be muxed into MP4 without re-encoding are copied as-is,
# preserving quality, channel layout, and sample rate:
#   aac, mp3, ac3, eac3, flac (all major browsers since 2017, Safari 17+),
#   opus (Chrome/Firefox since ~2014, Safari 17+), alac.
#
# Everything else (notably PCM variants from WAV/AIFF) is re-encoded to AAC
# at REENCODE_BITRATE. Channel count is never forced down — no -ac 2.
# ---------------------------------------------------------------------------
build_audio_map() {
    local reencode_bitrate="$1"
    AUDIO_STREAM_OPTS=()
    local idx=0
    while IFS= read -r codec; do
        case "$codec" in
            aac|mp3|mp3float|ac3|eac3|flac|opus|alac)
                echo "Audio stream $idx ($codec): copying without re-encode" >&2
                AUDIO_STREAM_OPTS+=(-c:a:$idx copy)
                ;;
            *)
                echo "Audio stream $idx ($codec): re-encoding to $AUDIO_CODEC at $reencode_bitrate" >&2
                AUDIO_STREAM_OPTS+=(-c:a:$idx "$AUDIO_CODEC" -b:a:$idx "$reencode_bitrate")
                ;;
        esac
        idx=$((idx + 1))
    done < <(ffprobe -v quiet -select_streams a \
                     -show_entries stream=codec_name \
                     -of csv=p=0 \
                     "$CLAPSHOT_INPUT_FILE" 2>/dev/null)
}

# Build ffmpeg command based on media type
case "$CLAPSHOT_MEDIA_TYPE" in
    "video")
        # Select only first video + optional audio streams.
        # -map 0:v:0        : first video stream only; excludes data/timecode tracks
        # -map 0:a?         : all audio streams, optional (no error if none present)
        # timecode=         : clear timecode metadata so the mp4 muxer does not
        #                     auto-create a companion tmcd track (ffmpeg 7.x behaviour)
        # No -ac 2          : channel count is preserved per stream
        build_audio_map "$AUDIO_BITRATE"

        FFMPEG_OPTS=(
            -map 0:v:0
            -map "0:a?"
            -metadata:s:v:0 timecode=
            -c:v "$VIDEO_CODEC"
            -vf "${VIDEO_FILTER_SCALE}=1920:-8"
            -preset "$VIDEO_PRESET"
            -strict experimental
            -b:v "$CLAPSHOT_TARGET_BITRATE"
        )
        # Append per-stream audio codec options separately: bash 3.x treats empty
        # array [@] expansion as unbound under set -u, so guard with a length check.
        [ ${#AUDIO_STREAM_OPTS[@]} -gt 0 ] && FFMPEG_OPTS+=("${AUDIO_STREAM_OPTS[@]}")

        # Add additional QSV options if using QSV codec
        if [[ "$VIDEO_CODEC" == *"qsv"* ]]; then
            FFMPEG_OPTS+=(-maxrate "$CLAPSHOT_TARGET_BITRATE")
            FFMPEG_OPTS+=(-bufsize $((CLAPSHOT_TARGET_BITRATE * 2)))
        fi

        # Add additional VideoToolbox options if using VideoToolbox codec
        if [[ "$VIDEO_CODEC" == *"videotoolbox"* ]]; then
            FFMPEG_OPTS+=(-maxrate "$CLAPSHOT_TARGET_BITRATE")
            FFMPEG_OPTS+=(-bufsize $((CLAPSHOT_TARGET_BITRATE * 2)))
        fi
        ;;

    "audio")
        # Waveform visualization: render a scrolling waveform as the video track,
        # and carry the original audio alongside it.
        # Audio is copied if already browser-compatible in MP4; re-encoded otherwise.
        FILTER_COMPLEX="color=c=white:s=2x720 [cursor]; \
[0:a] showwavespic=s=1920x720:split_channels=1:draw=scale:filter=peak:colors=#181818 [stillwave_peak];\
[0:a] showwavespic=s=1920x720:split_channels=1:draw=scale:filter=average [stillwave_avg];\
[stillwave_peak][stillwave_avg] overlay [stillwave];\
\
[stillwave] loop=loop=-1:size=1:start=0, fps=30, trim=duration=${CLAPSHOT_DURATION} [stillwave_loop]; \
[stillwave_loop][cursor] overlay=(W*t)/(${CLAPSHOT_DURATION}):0:shortest=1 [progress]; \
\
[progress] format=yuv420p [out]"

        build_audio_map "$AUDIO_BITRATE_AUDIO"

        FFMPEG_OPTS=(
            -r 60
            -filter_complex "$FILTER_COMPLEX"
            -map "[out]"
            -map "0:a"
            -strict experimental
            -c:v "$VIDEO_CODEC"
            -b:v "$CLAPSHOT_TARGET_BITRATE"
        )
        [ ${#AUDIO_STREAM_OPTS[@]} -gt 0 ] && FFMPEG_OPTS+=("${AUDIO_STREAM_OPTS[@]}")
        ;;

    "image")
        # Still image looped to a 1-second video clip; no audio expected.
        # -map 0:v:0 + timecode= : same tmcd-prevention as the video branch.
        FFMPEG_OPTS=(
            -map 0:v:0
            -metadata:s:v:0 timecode=
            -c:v "$VIDEO_CODEC"
            -tune stillimage
            -vf "scale=1920:-8,loop=-1:1"
            -t 1
            -r 24
            -pix_fmt yuv422p
            -b:v "$CLAPSHOT_TARGET_BITRATE"
        )
        ;;

    *)
        echo "ERROR: Unknown media type: $CLAPSHOT_MEDIA_TYPE" >&2
        exit 1
        ;;
esac

# Build complete ffmpeg command
CMD=(
    nice ffmpeg
    -nostats -hide_banner -y
)

# Add hardware acceleration options before input file
if [ -n "$HWACCEL" ]; then
    CMD+=(-hwaccel "$HWACCEL")
    if [ -n "$HWACCEL_DEVICE" ]; then
        CMD+=(-hwaccel_device "$HWACCEL_DEVICE")
    fi
    # For QSV, also add output format
    if [ "$HWACCEL" = "qsv" ]; then
        CMD+=(-hwaccel_output_format qsv)
    fi
    # For VideoToolbox, also add output format
    if [ "$HWACCEL" = "videotoolbox" ]; then
        CMD+=(-hwaccel_output_format videotoolbox_vld)
    fi
    # For NVENC, use CUDA acceleration
    if [ "$HWACCEL" = "nvenc" ]; then
        CMD[${#CMD[@]}-1]="cuda"  # Replace 'nvenc' with 'cuda' for ffmpeg
    fi
fi

CMD+=(-i "$CLAPSHOT_INPUT_FILE")

# Add progress reporting if pipe is available
if [ -n "${CLAPSHOT_PROGRESS_PIPE:-}" ]; then
    CMD+=(-progress "$CLAPSHOT_PROGRESS_PIPE")
fi

# Add media-specific options and output file
CMD+=("${FFMPEG_OPTS[@]}" "$OUTPUT_FILE")

# Log the command for debugging
echo "Executing: ${CMD[*]}" >&2

# Execute ffmpeg
exec "${CMD[@]}"
