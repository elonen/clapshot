# Env for the custom-proxy smoke test (consumed by run.sh). NOT a production example — see
# ../../custom-proxy/.env.example for that. This recipe ships NO Caddy: clapshot-web (nginx) is
# the public entry and TRUSTS inbound X-Remote-User-*. overlay.yml adds a stub 'authproxy' that
# injects those headers in front of clapshot-web; URL_BASE (and thus ws_url) points there so the
# WebSocket upgrade carries them too — what a browser's extraHTTPHeaders can't do.
CLAPSHOT_URL_BASE=http://authproxy/
CLAPSHOT_APP_TITLE=Clapshot smoke test
CLAPSHOT_VERSION=latest

# No HTWicket in this recipe; only the server health endpoint is polled before tests run.
READY_PROBES=api/health

# clapshot-web also publishes here for eyeballing a failing run at http://127.0.0.1:8080/ ;
# the tests themselves reach it in-network at http://clapshot-web/ above.
WEB_BIND=127.0.0.1
WEB_PORT=8080
