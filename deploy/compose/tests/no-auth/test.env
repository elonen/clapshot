# Env for the no-auth smoke test (consumed by run.sh). NOT a production example — see
# ../../no-auth/.env.example for that. URL_BASE points at overlay.yml's stub 'authproxy' (which
# injects spoofed X-Remote-User-* and forwards to the recipe's caddy), so CORS and the WS URL
# all agree on it and the spoofed headers reach clapshot-web's nginx — which must strip them.
CLAPSHOT_URL_BASE=http://authproxy/
CLAPSHOT_APP_TITLE=Clapshot smoke test
CLAPSHOT_VERSION=latest

# No HTWicket in this recipe, so only the server health endpoint is polled before tests run.
READY_PROBES=api/health

# Caddy also publishes here for eyeballing a failing run at http://127.0.0.1:8080/ ;
# the tests themselves use the in-network http://caddy/ above.
CADDY_BIND=127.0.0.1
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
