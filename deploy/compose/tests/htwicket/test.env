# Env for the HTWicket smoke test (consumed by run.sh). NOT a production example — see
# ../../htwicket/.env.example for that. URL_BASE uses the in-network service name 'caddy' so the
# Playwright container reaches the stack by name; CORS, cookies and the WS URL all agree on it.
CLAPSHOT_URL_BASE=http://caddy/

# Endpoints global-setup.ts polls before tests run (server reachable, HTWicket reachable).
READY_PROBES=api/health,htwicket/login
CLAPSHOT_APP_TITLE=Clapshot smoke test
CLAPSHOT_VERSION=latest
HTWICKET_VERSION=latest

# http in-network -> Secure cookies would never arrive (config-check enforces this pairing).
HTWICKET_INSECURE_COOKIES=true

# Deterministic admin password (htwicket-init seeds it instead of a random one).
CLAPSHOT_INITIAL_ADMIN_PASSWORD=smoketest-admin-pw

# Caddy also publishes here for eyeballing a failing run at http://127.0.0.1:8080/ ;
# the tests themselves use the in-network http://caddy/ above.
CADDY_BIND=127.0.0.1
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
