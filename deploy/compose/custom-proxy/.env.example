# =============================================================================
# Clapshot — custom-proxy recipe.  Copy to .env and edit.
#
# Authentication is done by YOUR reverse proxy in front (Authentik, Okta, Keycloak,
# Kerberos, ...). nginx TRUSTS the inbound X-Remote-User-* headers your proxy sets.
# Same stack as the no-auth recipe, only the nginx site.conf differs (trust vs strip).
#
# SECURITY: your proxy MUST authenticate every request, set X-Remote-User-*, and STRIP
# any client-supplied X-Remote-User-* first. This stack must be reachable ONLY through
# your proxy -- keep it on an internal address, never the public internet.
# =============================================================================

# --- App ---------------------------------------------------------------------
CLAPSHOT_URL_BASE=https://clapshot.example.com/   # the PUBLIC url your proxy serves
CLAPSHOT_APP_TITLE=Clapshot
#CLAPSHOT_LOGO_URL=clapshot-logo.svg
#CLAPSHOT_CORS=                                    # default: same as CLAPSHOT_URL_BASE
CLAPSHOT_VERSION=latest                            # pin a released version in production
#CLAPSHOT_DATA_DIR=                                # unset: managed volume.  Set: host path (uid 33 writable)
#CLAPSHOT_SERVER__DEBUG=true                       # any CLAPSHOT_SERVER__* overrides a server config key

# --- Where your proxy reaches this stack ------------------------------------
# This stack has no TLS of its own (TLS is at your proxy). Expose clapshot-web ONLY to
# your proxy:
#   - proxy on the same Compose network: target clapshot-web:80, and delete the two lines
#     below (no published host port needed); or
#   - proxy on the host/elsewhere: publish on a bound port your proxy forwards to (below).
WEB_BIND=127.0.0.1
WEB_PORT=8080
