# =============================================================================
# Clapshot — HTWicket recipe.  Copy to .env and edit.
#
# This is the ONLY file you edit. compose.yml, the nginx config, and htwicket.toml
# are versioned in the repo and update on `git pull`.
#
# The ACTIVE values below = local HTTP evaluation on http://127.0.0.1:8080/.
# For a public HTTPS deployment, see the PRODUCTION block at the bottom.
# =============================================================================

# --- App ---------------------------------------------------------------------
CLAPSHOT_URL_BASE=http://127.0.0.1:8080/       # public URL; the source of truth
CLAPSHOT_APP_TITLE=Clapshot
#CLAPSHOT_LOGO_URL=clapshot-logo.svg
#CLAPSHOT_CORS=                                 # default: same as CLAPSHOT_URL_BASE
CLAPSHOT_VERSION=latest                         # pin a released version in production
#CLAPSHOT_DATA_DIR=                             # unset: managed volume.  Set: host path (uid 33 writable)
#CLAPSHOT_SERVER__DEBUG=true                    # any CLAPSHOT_SERVER__* overrides a server config key

# Initial admin password — applied ONLY on first run (when 'admin' has no entry yet).
# Set it to choose the password; leave it unset for a RANDOM one printed in the
# htwicket-init logs (docker compose logs htwicket-init). Change it later with:
#   docker compose exec htwicket /usr/bin/htwicket user passwd admin
#CLAPSHOT_INITIAL_ADMIN_PASSWORD=

# --- Auth: HTWicket ----------------------------------------------------------
HTWICKET_VERSION=latest
HTWICKET_INSECURE_COOKIES=true                  # MUST be false when URL_BASE is https
#HTWICKET_PASSWORD_HASH=bcrypt                  # or argon2id (stronger; not plain-.htpasswd-verifiable)
#HTWICKET_MIN_PASSWORD_LEN=8
#HTWICKET_BASIC_AUTH_PASSTHROUGH=false          # true only for legacy clients that can't use cookies
#HTWICKET_DATA_DIR=                             # unset: managed volume.  Set: host path (uid 65532 writable)
#HTWICKET_JWT_SECRET_FILE=/run/secrets/htwicket_jwt   # pin the session key (Swarm / multiple replicas)

# --- TLS (Caddy): local HTTP eval -------------------------------------------
CADDY_BIND=127.0.0.1                            # localhost only; not reachable from the network
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443                           # unused in HTTP mode (bound but idle) — see README
#CADDY_DATA_DIR=

# =============================================================================
# PRODUCTION (public HTTPS, Let's Encrypt) — replace the values above with:
#
#   CLAPSHOT_URL_BASE=https://clapshot.example.com/
#   CLAPSHOT_VERSION=<a released version>
#   HTWICKET_INSECURE_COOKIES=false
#   CADDY_CERT_DOMAIN=clapshot.example.com      # host MUST match CLAPSHOT_URL_BASE
#   CADDY_BIND=0.0.0.0
#   CADDY_HTTP_PORT=80                          # 80 AND 443 must be publicly reachable for ACME
#   CADDY_HTTPS_PORT=443
#   CADDY_ACME_EMAIL=you@example.com            # optional: Let's Encrypt expiry notices
#
# Use your OWN certificates instead of Let's Encrypt — also set:
#   CADDY_TLS_CERT=/certs/fullchain.pem         # mount the files into the caddy service
#   CADDY_TLS_KEY=/certs/privkey.pem
# =============================================================================
